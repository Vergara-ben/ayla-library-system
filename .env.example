# Copy to .env and fill in. Never commit the real .env (it is gitignored).

# Core
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Keep False outside local development.
DEBUG=False

# Comma-separated domain names, e.g. ayla.example.com
ALLOWED_HOSTS=

# Full origins including scheme, e.g. https://ayla.example.com
CSRF_TRUSTED_ORIGINS=

# Database: postgresql or mysql
DATABASE_ENGINE=postgresql
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432        # 3306 for MySQL

# Email provider: smtp | brevo | sendgrid | mailgun | resend | console
# Use an API provider on hosts that block SMTP (e.g. free PythonAnywhere).
EMAIL_PROVIDER=smtp

# Needed for API providers. The From address must be verified with the provider.
EMAIL_API_KEY=
# Mailgun only:
MAILGUN_SENDER_DOMAIN=

# SMTP settings (only when EMAIL_PROVIDER=smtp)
# For Gmail use an App Password. Leave blank to print mail to the console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Optional
# Set False only if a proxy in front of the app already forces HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
