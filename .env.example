# Copy to .env and fill in. Never commit the real .env -- it is gitignored.
# See DEPLOYMENT.md for what each of these does.

# ── Core ──────────────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Leave False for anything other than local development.
DEBUG=False

# Comma-separated. With DEBUG=False an empty value refuses every request.
ALLOWED_HOSTS=

# Full origins including scheme, e.g. https://ayla.example.com
CSRF_TRUSTED_ORIGINS=

# ── Database ──────────────────────────────────────────────────────────
# 'postgresql' or 'mysql'. Never SQLite: it cannot lock rows, which would
# silently disable the protection against lending one copy to two patrons.
DATABASE_ENGINE=postgresql
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432        # 3306 for MySQL

# ── Email ─────────────────────────────────────────────────────────────
# How mail leaves: smtp | brevo | sendgrid | mailgun | resend | console
#
# Use an API provider (not smtp) on any host that blocks outbound SMTP ports --
# a free PythonAnywhere account is the usual case. The app code is identical
# either way; only this setting changes.
EMAIL_PROVIDER=smtp

# Required when EMAIL_PROVIDER is one of the API providers above.
# The From address must be a sender you have verified with that provider.
EMAIL_API_KEY=
# Mailgun only:
MAILGUN_SENDER_DOMAIN=

# ── SMTP settings (only used when EMAIL_PROVIDER=smtp) ────────────────
# For Gmail this must be an App Password, not the account password.
# Leave both blank and mail is printed to the console instead of sent.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ── Optional ──────────────────────────────────────────────────────────
# Set False only if something in front of the app already forces HTTPS.
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
